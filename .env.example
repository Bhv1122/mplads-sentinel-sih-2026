# =============================================================================
# PostgreSQL Database Configuration for MPLADS Project
# Copy this file to .env and configure with your local credentials.
# DO NOT commit .env with real passwords to version control.
# =============================================================================

# Database Connection URL (Recommended)
DATABASE_URL=postgresql+psycopg2://your_postgres_username:your_secure_password@localhost:5432/mplads_db

# Alternative Individual Parameters
DB_HOST=localhost
DB_PORT=5432
DB_NAME=mplads_db
DB_USER=your_postgres_username
DB_PASSWORD=your_secure_password
